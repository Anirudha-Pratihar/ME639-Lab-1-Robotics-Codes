<mujoco model="turtlebot3_waffle_pi">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic"/>

  <default>
    <joint damping="0.2"/>
    <geom contype="1" conaffinity="1" friction="1.0 0.05 0.01" solref="0.01 1" solimp="0.9 0.95 0.001"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="body_mat" rgba="0.15 0.15 0.15 1"/>
    <material name="wheel_mat" rgba="0.05 0.05 0.05 1"/>
    <material name="caster_mat" rgba="0.4 0.4 0.4 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid"/>

    <!-- Base frame axes for reference at the origin -->
    <site name="world_origin" pos="0 0 0.001" size="0.01" rgba="1 1 1 1"/>

    <body name="base" pos="0 0 0.066">
      <!-- free joint: robot can translate/rotate freely, driven by wheel torques -->
      <freejoint name="base_free"/>
      <inertial pos="0 0 0" mass="1.8" diaginertia="0.02 0.02 0.03"/>

      <!-- Waffle Pi footprint approx: radius 0.14 m. Raised + shortened so it clears
           the ground (wheels/caster bear the load, not the belly). -->
      <geom name="base_geom" type="cylinder" pos="0 0 0.025" size="0.14 0.055" material="body_mat" mass="0" contype="0" conaffinity="0"/>
      <geom name="top_plate" type="cylinder" pos="0 0 0.082" size="0.14 0.005" material="caster_mat" mass="0" contype="0" conaffinity="0"/>

      <!-- Heading marker so you can SEE which way is "forward" (+X of body frame) -->
      <geom name="heading_arrow" type="box" pos="0.11 0 0.086" size="0.03 0.01 0.005" rgba="1 0 0 1" mass="0" contype="0" conaffinity="0"/>

      <!-- Body-frame visualization site: this is what we read the rotation matrix from -->
      <site name="body_frame" pos="0 0 0.08" size="0.015" rgba="1 1 1 1"/>

      <!-- Wheels: diameter 66mm -> radius 0.033, separation 0.287 m -->
      <body name="wheel_left" pos="0 0.1435 -0.033">
        <joint name="joint_wheel_left" type="hinge" axis="0 1 0" damping="0.15"/>
        <geom name="geom_wheel_left" type="cylinder" size="0.033 0.018" quat="0.7071068 0.7071068 0 0"
              material="wheel_mat" friction="1.2 0.05 0.01" mass="0.05"/>
      </body>

      <body name="wheel_right" pos="0 -0.1435 -0.033">
        <joint name="joint_wheel_right" type="hinge" axis="0 1 0" damping="0.15"/>
        <geom name="geom_wheel_right" type="cylinder" size="0.033 0.018" quat="0.7071068 0.7071068 0 0"
              material="wheel_mat" friction="1.2 0.05 0.01" mass="0.05"/>
      </body>

      <!-- Passive caster (ball) at the rear for stability -->
      <body name="caster" pos="-0.11 0 -0.045">
        <joint name="caster_free" type="ball" damping="0.001"/>
        <geom name="caster_geom" type="sphere" size="0.018" material="caster_mat" friction="0.2 0.005 0.0001" mass="0.02"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="act_wheel_left"  joint="joint_wheel_left"  kv="8" ctrlrange="-6 6"/>
    <velocity name="act_wheel_right" joint="joint_wheel_right" kv="8" ctrlrange="-6 6"/>
  </actuator>
</mujoco>
